<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MPC-BE (ARM64)" Manufacturer="travertexs" Version="$(Version)"
           UpgradeCode="72930B82-9B61-4434-8D75-4820868A98D1" Scope="perMachine" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of MPC-BE (ARM64) is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="PlayerIcon" SourceFile="!(bindpath.payload)\mpc-be-arm64.exe" />
    <Property Id="ARPPRODUCTICON" Value="PlayerIcon" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MPC-BE ARM64" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="Player" Title="MPC-BE">
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="!(bindpath.payload)\mpc-be-arm64.exe" KeyPath="yes">
          <Shortcut Id="StartMenuPlayer" Directory="ProgramMenuFolder" Name="MPC-BE (ARM64)" Advertise="yes" WorkingDirectory="INSTALLFOLDER" />
        </File>
      </Component>
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.payload)\**">
        <Exclude Files="!(bindpath.payload)\mpc-be-arm64.exe" />
      </Files>
    </Feature>
  </Package>
</Wix>
